# Host ports for the docker-compose services (docker-compose.yml). Only
# take effect when Compose is run with `--env-file .env.docker` (see that
# file's header comment) — env_file: alone doesn't feed variable
# substitution in the compose file itself.
ASSISTANT_PORT=8000
CALDAV_PORT=5232

# Syncthing's web GUI (only needed for the one-time device-pairing step).
# Bound to 127.0.0.1 by default — reachable from this host only, never the
# LAN. Set SYNCTHING_GUI_HOST=0.0.0.0 to expose it beyond localhost instead.
SYNCTHING_GUI_HOST=127.0.0.1
SYNCTHING_GUI_PORT=8384

# UID/GID the syncthing container runs as (docker-compose.yml's `syncthing`
# service) — must match whoever owns ./data on the host, or Syncthing can't
# write its own config/cert there. setup_check.sh auto-fills these in from
# `id -u`/`id -g` the first time it runs; only override by hand if you
# specifically need the container running as a different host user.
#PUID=1000
#PGID=1000

API_TOKEN=YOUR_SUPER_SECRET_SECURE_TOKEN

# Dashboard login/session (auth.py, static/login.html) — gates the browser
# dashboard only, kept separate from API_TOKEN above so rotating the
# ESP32's device credential doesn't force a dashboard relogin, and vice
# versa.
DASHBOARD_PASSWORD=CHANGE_ME_DASHBOARD_PASSWORD

# Signs the session cookie (itsdangerous, via Starlette's SessionMiddleware).
# Must be a long, random, private string. Rotating it logs everyone out —
# every existing session cookie stops validating immediately.
SESSION_SECRET_KEY=CHANGE_ME_SESSION_SECRET_KEY

# Only set true once this app is served over HTTPS end-to-end (e.g. a
# reverse proxy/tunnel terminating TLS in front of it). A Secure cookie is
# silently never sent by the browser over plain HTTP, so flipping this on
# before that's in place makes login *appear* to succeed (POST /login
# still returns 200) while the session cookie never actually sticks.
SESSION_COOKIE_SECURE=false

# How many days a browser session stays valid before requiring login again.
SESSION_MAX_AGE_DAYS=30

# LM Studio — used for the chatbot (agent/graph.py)
LM_STUDIO_URL=http://localhost:1234/v1
CHAT_MODEL=gemma-e4b-it
EMBEDDING_MODEL=nomic-embed-text

# SearXNG — used for the web search integration (agent/tools/web_search.py)
SEARXNG_URL=http://localhost:8080

# CalDAV — used for the calendar integration (agent/tools/calendar.py,
# jobs/calendar_sync.py, jobs/device_sync.py). Point this at the bundled
# Radicale service (see docker-compose.yml's `caldav` service) or any
# external CalDAV server (Nextcloud, Baikal, Fastmail, etc.) — the client
# is protocol-generic, not tied to one provider.
#
# For the bundled Radicale service, just fill these in like any other
# secret in this file — no separate setup step. CALDAV_USERNAME/PASSWORD
# double as Radicale's own login (its entrypoint auto-provisions its
# htpasswd file from these two values on every startup), and the app
# auto-creates the calendar collection itself at startup. The username
# you pick MUST match the first path segment of CALDAV_URL below (Radicale
# scopes each user to their own /<user>/... path).
#
# CALDAV_URL is the full URL of one calendar collection, exactly as your
# CalDAV server presents it (trailing slash recommended). For the bundled
# Radicale service from inside the assistant container, this is
# http://caldav:5232/<user>/<collection>/ — <collection> can be any name
# you like (e.g. "personal"), it gets created automatically.
CALDAV_URL=http://caldav:5232/myuser/personal/
CALDAV_USERNAME=myuser
CALDAV_PASSWORD=your_caldav_password

# Gotify — used for error notifications from the /voice background pipeline
GOTIFY_URL=https://your-gotify-domain.com
GOTIFY_TOKEN=your_gotify_app_token

# SMTP — used for the end-of-day digest email (jobs/digest.py)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=assistant@example.com
DIGEST_EMAIL_TO=you@example.com

# Notes vault — path to the Obsidian vault folder, shared with the
# syncthing container via docker-compose (see docker-compose.yml)
VAULT_PATH=/app/vault

# Optional — huggingface_hub (used by faster-whisper, utils/transcription.py)
# rate-limits unauthenticated requests and warns loudly about it in the logs.
# A free Hugging Face account token (https://huggingface.co/settings/tokens,
# "Read" scope is enough) lifts that limit and speeds up the one-time model
# download. Leave unset and it still works, just slower on first run.
#HF_TOKEN=your_huggingface_token

# Public base URL this app is reachable at, used only to build the
# tap-to-open link on mental-health check-in Gotify notifications
# (jobs/checkin.py's fire_checkin). Optional — leave unset and check-ins
# still fire, just without a click-through link. See static/checkin.html
# for the magic-link page this points to.
PUBLIC_BASE_URL=https://your-domain.example.com

# Standing app-level toggles — startup defaults, changeable live via
# GET/POST /settings without a restart (see agent/settings.py)
LEARNING_MODE_DEFAULT=true

# Loglevel — DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO